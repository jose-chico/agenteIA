# --- BLING PAGAMENTOS ---
# Link de checkout do Bling (OBRIGATÓRIO para liberação automática do chat).
# Use placeholders para o Falcon injetar os dados do cliente:
# {userId} {email} {name} {reference}
# Exemplo:
# BLING_PAYMENT_LINK=https://checkout.bling.com.br/seu-checkout?reference={reference}&email={email}&name={name}&userId={userId}
BLING_PAYMENT_LINK=https://www.bling.com.br/pix.gerar.qrcode.php?id=25182003690&tipoGeracao=1&view=true
BLING_WEBHOOK_SECRET=c41944ee61932fee8bc95d5a02d8e597388250209ff0d36c4b7a3046c62e#fR8dMv$3YkN1wS6tH0cU5
# Fallback sem webhook: tenta confirmar pagamento lendo a pagina publica da cobranca.
# true (padrao): habilitado | false: desabilitado
BLING_PUBLIC_STATUS_CHECK=true
PIX_KEY=6037b8eb-5956-4886-9fc0-98cd16119dc0
PIX_RECEIVER_NAME=FALCON AI
PIX_CITY=SAO PAULO
PIX_AMOUNT=1.00


